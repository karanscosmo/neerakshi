# ─── Neerakshi environment variables ───────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# Postgres connection string (Neon via the Vercel Marketplace sets this for you).
# If empty in local development, the app falls back to an embedded PGlite
# database stored in ~/.cache/neerakshi/pglite (override with PGLITE_DIR; not usable on Vercel).
DATABASE_URL=

# Copernicus Data Space Ecosystem OAuth client (Sentinel Hub Statistical API).
# Create at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings → OAuth clients.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Telegram bot token from @BotFather, and a random string used to verify
# that webhook calls really come from Telegram (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public bot username without "@", shown in the app for the /start link.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Passcode for the officer view (/impact). Use a long random string.
ADMIN_PASSCODE=

# 32+ random bytes (hex or base64) used to sign the anonymous session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of the deployment, used in Telegram links (e.g. https://neerakshi.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Optional: data.gov.in API key (only used by the pipeline, never by the app).
DATA_GOV_IN_API_KEY=

# Optional: server-side text-to-speech key for Telegram voice notes.
# Leave empty to disable; the in-app "Listen" button uses the browser's Web Speech API.
TTS_API_KEY=

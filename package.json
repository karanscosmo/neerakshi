{
  "name": "neerakshi",
  "version": "0.1.0",
  "private": true,
  "description": "Neerakshi \u2014 satellite-driven irrigation advisory and agricultural water-stress atlas for India",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",

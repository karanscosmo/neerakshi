    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^7.1.0",
    "server-only": "^0.0.1",
    "terra-draw": "^1.38.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",

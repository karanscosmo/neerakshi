    "atlas:build": "tsx scripts/build-atlas-assets.ts",
    "telegram:set-webhook": "tsx scripts/set-telegram-webhook.ts",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "export:advisories": "tsx scripts/export-advisories.ts",
    "pipeline": "python -m pipeline.run_all",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
